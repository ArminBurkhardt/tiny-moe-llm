# vast_init -- rented-box environment init (PLAN.md's Vast.ai runbook, step 1-2).
#
# Committed counterpart to the local env_init (gitignored, WSL-specific: CUDA/WSL library paths +
# a local venv). This one has to be committed because the rented instance is ephemeral -- there's
# no persistent, hand-built env to fall back on after an interruption/reclaim, so the init has to
# come from the repo itself. The NGC image (nvcr.io/nvidia/pytorch:25.xx-py3) ships torch,
# transformer_engine, and flash-attn prebuilt for sm90 -- do NOT `pip install -r requirements.txt`
# wholesale, its TE/flash-attn wheels target sm120 and would clobber the working prebuilt ones.
# No WSL paths, no venv activation: this runs directly in the NGC image's system python.

# non-CUDA deps only -- torch/transformer_engine/flash_attn come from the image, skip them here.
pip install --no-cache-dir \
    "transformers>=5.5.4" \
    "sentence-transformers>=5.2.0" \
    "numpy>=1.21.0" \
    "pandas>=3.0.0" \
    fastparquet \
    "pyarrow>=14.0.0" \
    "huggingface_hub>=0.27.0" \
    "zstandard>=0.23.0" \
    "matplotlib>=3.10.0" \
    "bitsandbytes>=0.30.0" \
    "accelerate>=1.13.0"

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

if [ -z "$HF_TOKEN" ]; then
  echo "vast_init: HF_TOKEN is not set -- scripts/prepare_data.py's gated source" \
       "(nvidia/Nemotron-CC-Math-v1) will fail with a 401/403 until you accept its access" \
       "request on huggingface.co and export HF_TOKEN." >&2
fi
