# copy to scripts/ops/ops.env (gitignored) and fill in. read by the scripts in scripts/ops/.
MN5_USER=CHANGE_USER
MN5_TRANSFER_HOST=transfer1.bsc.es
MN5_LOGIN_HOST=alogin1.bsc.es
REMOTE_REPO=/gpfs/projects/CHANGE_PROJECT/tiny-llm
REMOTE_DATA_ROOT=/gpfs/projects/CHANGE_PROJECT/run2
# the ssh master socket the user opens by hand in WSL (README: "Supervision")
SSH_SOCK=$HOME/.ssh/mn5.sock
# the transfer host (rsync, push, pull) has its own master socket, opened by hand like the login one
SSH_SOCK_TRANSFER=$HOME/.ssh/mn5-transfer.sock
# the python that has huggingface_hub (the one the hf CLI uses; a venv's python when hf lives in its own venv), used for the
# private-repo check before every upload. default python3
HF_PYTHON=python3
# the project's transfer allowance, counted in both directions
TRANSFER_BUDGET_GB=2000
# one ledger file for push_code, push_corpus, pull_exports and mirror_sources.py push, an absolute path (default: the
# repo root's ops_transfer_ledger.tsv). a machine counts its own transfers: the relay VM's ledger is separate from the PC's
# (keep the pulls on the relay within what the PC's pushes leave of the allowance; SUPERVISOR.md, Transfer ledger)
OPS_LEDGER=
# pull_exports.sh --hf and the relay VM: a private HF repo for the exported weights, empty = no upload
HF_EXPORT_REPO=
# relay VM only (scripts/ops/relay/): the ntfy topic for phone alerts. a long random name, it is the only secret
# protecting the channel: openssl rand -hex 12
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# where the relay pulls exports, reads and logs to (and uploads from)
RELAY_LOCAL_DIR=./run2_pulled
# relay VM: one low priority "relay alive" ntfy per this many hours with the latest status line (0 = off). silence for
# longer than this means the relay, the timer or the VM is down
HEARTBEAT_HOURS=24
# relay VM: upload the growing logs (reads/*.log, joblogs/) to HF at most every this many hours; exports and json reads
# go up at every poll
LOG_UPLOAD_HOURS=6
