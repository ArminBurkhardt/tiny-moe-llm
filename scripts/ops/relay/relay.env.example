# copy to scripts/ops/relay/relay.env (gitignored) on the relay VM. read by mn5-sock@.service through systemd, which
# does not expand $HOME or ~: write absolute paths. the two socket paths must equal SSH_SOCK and SSH_SOCK_TRANSFER in
# scripts/ops/ops.env (written there with the same absolute paths).
MN5_USER=CHANGE_USER
MN5_HOST_login=alogin1.bsc.es
MN5_HOST_transfer=transfer1.bsc.es
MN5_SOCK_login=/home/CHANGE_VM_USER/.ssh/mn5.sock
MN5_SOCK_transfer=/home/CHANGE_VM_USER/.ssh/mn5-transfer.sock
